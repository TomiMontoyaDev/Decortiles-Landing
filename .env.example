# Copia este archivo como .env.local para desarrollo. Nunca subas .env.local.
# Las NEXT_PUBLIC_* se incrustan al construir: si cambias una en Render o GitHub, vuelve a desplegar.
#
# ── Dónde está publicada la landing ──────────────────────────────────────────
#   Render (Static Site) ....... https://decortiles-landing.onrender.com
#   GitHub Pages ............... https://tomimontoyadev.github.io/Decortiles-Landing/
#   Dominio final (pendiente) .. https://proyectos.decorcolombiatiles.com
#   Local ...................... http://localhost:3000
#
#   Dashboard de leads: <cualquiera de las anteriores>/admin/
#
#   Qué cambia en cada una:
#   | Despliegue    | NEXT_PUBLIC_SITE_URL                                    | NEXT_PUBLIC_BASE_PATH |
#   |---------------|---------------------------------------------------------|-----------------------|
#   | Local         | http://localhost:3000                                   | (vacío)               |
#   | Render        | https://decortiles-landing.onrender.com                 | (vacío)               |
#   | GitHub Pages  | https://tomimontoyadev.github.io/Decortiles-Landing     | /Decortiles-Landing   |
#   | Dominio final | https://proyectos.decorcolombiatiles.com                | (vacío)               |
#   En GitHub Pages las dos las pone solo el workflow (.github/workflows/pages.yml).

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública sin "/" final (OG image y redirect del double opt-in). Ver tabla de arriba.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Subruta del sitio. Solo GitHub Pages sin dominio propio la usa. Ver tabla de arriba.
NEXT_PUBLIC_BASE_PATH=

# WhatsApp de todos los botones y mensajes prellenados (solo dígitos, con 57).
# OJO: en las plantillas de emails/ el número está escrito en el HTML; si cambia, actualizarlo allá también.
NEXT_PUBLIC_WHATSAPP=573128019754

# ── Supabase: leads y dashboard /admin/ (iguales en todos los despliegues) ───
# Panel: https://supabase.com/dashboard/project/ufhkwmszrzdbprodzxaf
# URL del proyecto y clave publishable: son públicas por diseño (los datos los protege RLS).
NEXT_PUBLIC_SUPABASE_URL=https://ufhkwmszrzdbprodzxaf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oNlHCnkGcaNayKxxeF0s7g_3XCTyP0D
# Edge Function del formulario (se desplegó con el nombre "swift-task").
NEXT_PUBLIC_LEAD_ENDPOINT=https://ufhkwmszrzdbprodzxaf.supabase.co/functions/v1/swift-task
#
# NO van aquí (viven en Supabase → Edge Functions → Secrets): BREVO_API_KEY, BREVO_LIST_ID,
# BREVO_DOI_TEMPLATE_ID, LEAD_NOTIFY_EMAIL, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME, SITE_URL y
# LEAD_ALLOWED_ORIGINS. Para este último usa los orígenes (sin ruta) de la tabla de arriba:
#   https://decortiles-landing.onrender.com,https://tomimontoyadev.github.io,https://proyectos.decorcolombiatiles.com,http://localhost:3000
# Nunca pongas la clave secreta (sb_secret_… / service_role) en un .env del sitio.

# ── Tracking (público). Si están vacías, no se carga ningún script. ───────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# Formato: AW-123456789/AbCdEfGhIjK (id de conversión / etiqueta).
NEXT_PUBLIC_GADS_CONVERSION=

# ── Solo modo servidor (no se usa en la versión estática; README, sección 12) ─
# Orígenes que pueden enviar a /api/lead (separados por coma).
# LEAD_ALLOWED_ORIGINS=https://decortiles-landing.onrender.com,https://tomimontoyadev.github.io
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# LEAD_NOTIFY_EMAIL=
# BREVO_SENDER_EMAIL=contacto@decorcolombiatiles.com
# BREVO_SENDER_NAME=DECORTILES
# LEAD_TOKEN_SECRET=
# META_CAPI_TOKEN=
# META_CAPI_TEST_CODE=
