# Copia este archivo como .env.local para desarrollo. En Vercel, define las mismas
# variables en Project Settings → Environment Variables. Nunca subas .env.local.

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública (se usa para la OG image y el redirect del double opt-in).
NEXT_PUBLIC_SITE_URL=https://proyectos.decorcolombiatiles.com

# ── Brevo (solo servidor) ────────────────────────────────────────────────────
# API key v3: Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
# Id numérico de la lista "Landing Proyectos" (Contacts → Lists).
BREVO_LIST_ID=
# Opcional. Id de la plantilla de double opt-in. Si se define, se activa el DOI.
BREVO_DOI_TEMPLATE_ID=
# Opcional. Correo interno que recibe cada lead para que ventas responda rápido.
LEAD_NOTIFY_EMAIL=
# Remitente de las notificaciones. Debe ser un remitente verificado en Brevo.
BREVO_SENDER_EMAIL=contacto@decorcolombiatiles.com
BREVO_SENDER_NAME=DECORTILES

# Opcional. Secreto para firmar el token del paso 2. Si no se define, se usa BREVO_API_KEY.
LEAD_TOKEN_SECRET=

# ── Tracking (público). Si están vacías, no se carga ningún script. ───────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# Formato: AW-123456789/AbCdEfGhIjK (id de conversión / etiqueta).
NEXT_PUBLIC_GADS_CONVERSION=

# ── Meta Conversions API (opcional, TODO) ─────────────────────────────────────
# Token de acceso de la API de conversiones (Events Manager → Settings).
META_CAPI_TOKEN=
# Código de prueba del Events Manager; vacíalo en producción.
META_CAPI_TEST_CODE=
