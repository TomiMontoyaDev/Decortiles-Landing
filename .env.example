# Copia este archivo como .env.local para desarrollo. En Vercel, define las mismas
# variables en Project Settings → Environment Variables. Nunca subas .env.local.

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública (se usa para la OG image y el redirect del double opt-in).
NEXT_PUBLIC_SITE_URL=https://proyectos.decorcolombiatiles.com

# WhatsApp de todos los botones y mensajes prellenados (solo dígitos, con 57).
# OJO: en las plantillas de emails/ el número está escrito en el HTML; si cambia, actualizarlo allá también.
NEXT_PUBLIC_WHATSAPP=573128019754

# ── Versión estática (recomendada: GitHub Pages / Render Static Site) ────────
# Solo para `npm run build:static`. Subruta del sitio (GitHub Pages sin dominio propio: /Decortiles-Landing).
NEXT_PUBLIC_BASE_PATH=
# Supabase (Connect / Project Settings → API Keys): URL del proyecto y clave publishable
# (sb_publishable_…; en proyectos antiguos, la "anon" en NEXT_PUBLIC_SUPABASE_ANON_KEY). Las dos son públicas.
# El formulario envía a <url>/functions/v1/lead y el dashboard /admin/ inicia sesión con ellas.
# Las claves de Brevo de la versión estática van en los Secrets de la Edge Function, no aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: otra URL para el formulario.
NEXT_PUBLIC_LEAD_ENDPOINT=

# ── Solo modo servidor (Vercel / Render Web Service, `npm run build`) ────────
# Orígenes que pueden enviar a /api/lead (separados por coma).
LEAD_ALLOWED_ORIGINS=https://tomimontoyadev.github.io

# Brevo:
# API key v3: Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
# Id numérico de la lista "Landing Proyectos" (Contacts → Lists).
BREVO_LIST_ID=
# Opcional. Id de la plantilla de double opt-in. Si se define, se activa el DOI.
BREVO_DOI_TEMPLATE_ID=
# Opcional. Correo interno que recibe cada lead para que ventas responda rápido.
LEAD_NOTIFY_EMAIL=
# Remitente de las notificaciones. Debe ser un remitente verificado en Brevo.
BREVO_SENDER_EMAIL=contacto@decorcolombiatiles.com
BREVO_SENDER_NAME=DECORTILES

# Opcional. Secreto para firmar el token del paso 2. Si no se define, se usa BREVO_API_KEY.
LEAD_TOKEN_SECRET=

# ── Tracking (público). Si están vacías, no se carga ningún script. ───────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# Formato: AW-123456789/AbCdEfGhIjK (id de conversión / etiqueta).
NEXT_PUBLIC_GADS_CONVERSION=

# ── Meta Conversions API (opcional, TODO) ─────────────────────────────────────
# Token de acceso de la API de conversiones (Events Manager → Settings).
META_CAPI_TOKEN=
# Código de prueba del Events Manager; vacíalo en producción.
META_CAPI_TEST_CODE=
